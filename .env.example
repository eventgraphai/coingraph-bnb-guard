# Copy to .env and fill in locally. Never commit .env. Never paste these into chat.
COINGRAPH_API_URL=https://coingraph.ai
COINGRAPH_API_KEY=
NOWNODES_API_KEY=
BSCSCAN_API_KEY=
# CoinMarketCap API key (free Basic plan works): https://pro.coinmarketcap.com/signup
CMC_API_KEY=
# Atlas Oracle (ask the Atlas team for BNB Chain feed addresses and an API key)
ATLAS_API_KEY=
ATLAS_FEED_ADDRESS=
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
OPBNB_TESTNET_RPC=https://opbnb-testnet-rpc.bnbchain.org
# CoinGraph answer-signing key. Created by `pnpm signer`. Do not edit or share.
SIGNER_PRIVATE_KEY=
# Hackathon wallet private key (a fresh wallet with a few dollars of BNB). Paste it here yourself.
AGENT_PRIVATE_KEY=

# Cournot Intelligence Oracle (optional prepaid key; works without one on the free allowance)
COURNOT_API_KEY=
